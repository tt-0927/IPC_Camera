#include "JsonInterfase.h"
#include <fstream>
#include <iostream>
#include <cstring>

int main()
{
    /* ====================== 加载json文件并初始化 ====================== */
    std::string strConfigPath = "aiConfig.json";
    /* 读取json文件 */
    std::ifstream File(strConfigPath);
    if (!File) 
    {
        printf("[无法打开json文件]: %s\n", strConfigPath.c_str());
        return false;
    }
    /* 读取文件内容到 std::string */
    std::string strJson((std::istreambuf_iterator<char>(File)),
                        std::istreambuf_iterator<char>());
    const char* pchJson = strJson.c_str();
    /* 解析Json数据-获取错误 */
    if (NULL == pchJson)
    {
        printf("传入参数异常\n");
        return 0;
    }


    Json::Object* pJsonHandle = NULL;
    Json::Object* pJsonData   = NULL;
    Json::Object* pJsonDataItem   = NULL;
    Json::Object* pItemObject      = NULL;
    bool          bRet        = false;

    pJsonHandle = Json::init(pchJson);

    /* ========================= 解析主体信息 ========================== */
    /* 1、版本号 */
    std::string strVersion;
    bRet = Json::get(pJsonHandle, "version", strVersion);
    if (!bRet)
    {
        printf("解析Version字段失败\n");
        return 0;
    }
    printf("version [%s]\n",strVersion.c_str());
    /* 2、模型的名字 */
    std::string strModelName;
    bRet = Json::get(pJsonHandle, "model", strModelName);
    if (!bRet)
    {
        printf("解析model字段失败\n");
        return 0;
    }
    printf("model [%s]\n",strModelName.c_str());
    /* 3、备注信息 */
    std::string strNote;
    bRet = Json::get(pJsonHandle, "notes", strNote);
    if (!bRet)
    {
        printf("解析notes字段失败\n");
        return 0;
    }
    printf("notes [%s]\n",strNote.c_str());
    /* 4、模型地址 */
    std::string strModelPath;
    bRet = Json::get(pJsonHandle, "model_path", strModelPath);
    if (!bRet)
    {
        printf("解析model_path字段失败\n");
        return 0;
    }
    printf("model_path [%s]\n",strModelPath.c_str());

    /* ========================= 预处理 ========================== */
    pJsonData = Json::get(pJsonHandle, "pre_process");
    if (!pJsonData)
    {
        printf("解析[data]字段失败\n");
        return 0;
    }

    /* 1、获取模型输入大小限制 */
    pJsonDataItem = Json::get(pJsonData, "size");
    if (!pJsonDataItem)
    {
        printf("解析[pJsonData]字段失败\n");
        return 0;
    }
    int nSize = Json::Array::size(pJsonDataItem);
    if (nSize <= 0)
    {
        printf("解析[数组大小异常]\n");
        return 0;
    }
    for (int i = 0; i < nSize; i++)
    {
        /* 获取数组的节点 */
        pItemObject = Json::Array::get(pJsonDataItem, i);
        if (NULL == pItemObject)
        {
            printf("获取数组节点失败\n");
            continue;
        }

        int nSizeItem;
        bRet = Json::get(pItemObject, nSizeItem);
        if (!bRet)
        {
            printf("解析[size]字段失败\n");
            continue;
        }
        printf("size [%d]\n",nSizeItem);
    }
    /* 2、图片通道 */
    int nChannel;
    bRet = Json::get(pJsonData, "channel", nChannel);
    if (!bRet)
    {
        printf("解析channel字段失败\n");
        return 0;
    }
    printf("channel [%d]\n",nChannel);
    /* 3、输入是否为rgb */
    int nRgb;
    bRet = Json::get(pJsonData, "rgb", nRgb);
    if (!bRet)
    {
        printf("解析rgb字段失败\n");
        return 0;
    }
    printf("rgb [%d]\n",nRgb);
    /* 4、归一化-均值 */
    pJsonDataItem = Json::get(pJsonData, "mean");
    if (!pJsonDataItem)
    {
        printf("解析[pJsonData]字段失败\n");
        return 0;
    }
    nSize = Json::Array::size(pJsonDataItem);
    if (nSize <= 0)
    {
        printf("解析[数组大小异常]\n");
        return 0;
    }
    for (int i = 0; i < nSize; i++)
    {
        /* 获取数组的节点 */
        pItemObject = Json::Array::get(pJsonDataItem, i);
        if (NULL == pItemObject)
        {
            printf("获取数组节点失败\n");
            continue;
        }

        int nMean;
        bRet = Json::get(pItemObject, nMean);
        if (!bRet)
        {
            printf("解析[mean]字段失败\n");
            continue;
        }
        printf("mean [%d]\n",nMean);
    }
    /* 5、归一化-方差 */
    pJsonDataItem = Json::get(pJsonData, "std");
    if (!pJsonDataItem)
    {
        printf("解析[pJsonData]字段失败\n");
        return 0;
    }
    nSize = Json::Array::size(pJsonDataItem);
    if (nSize <= 0)
    {
        printf("解析[数组大小异常]\n");
        return 0;
    }
    for (int i = 0; i < nSize; i++)
    {
        /* 获取数组的节点 */
        pItemObject = Json::Array::get(pJsonDataItem, i);
        if (NULL == pItemObject)
        {
            printf("获取数组节点失败\n");
            continue;
        }

        int nStd;
        bRet = Json::get(pItemObject, nStd);
        if (!bRet)
        {
            printf("解析[std]字段失败\n");
            continue;
        }
        printf("std [%d]\n",nStd);
    }
    /* 6、图片缩放时，是否填充 */
    int nPadding;
    bRet = Json::get(pJsonData, "padding", nPadding);
    if (!bRet)
    {
        printf("解析padding字段失败\n");
        return 0;
    }
    printf("padding [%d]\n",nPadding);

    /* ========================= 推理 ========================== */
    pJsonData = Json::get(pJsonHandle, "inference");
    if (!pJsonData)
    {
        printf("解析[data]字段失败\n");
        return 0;
    }
    /* 1、推理使用的框架 */
    std::string strBackend;
    bRet = Json::get(pJsonData, "backend", strBackend);
    if (!bRet)
    {
        printf("解析backend字段失败\n");
        return 0;
    }
    printf("backend [%s]\n",strBackend.c_str());
    
    /* ========================= 后处理 ========================== */
    pJsonData = Json::get(pJsonHandle, "post_precess");
    if (!pJsonData)
    {
        printf("解析[data]字段失败\n");
        return 0;
    }
    /* 1、置信度 */
    float fConfidence;
    bRet = Json::get(pJsonData, "confidence", fConfidence);
    if (!bRet)
    {
        printf("解析confidence字段失败\n");
        return 0;
    }
    printf("confidence [%f]\n",fConfidence);
    /* 2、非极大值抑制阈值 */
    float fNms;
    bRet = Json::get(pJsonData, "nms", fNms);
    if (!bRet)
    {
        printf("解析nms字段失败\n");
        return 0;
    }
    printf("nms [%f]\n",fNms);
    /* 3、标签列表 */
    pJsonDataItem = Json::get(pJsonData, "label_name");
    if (!pJsonDataItem)
    {
        printf("解析[label_name]字段失败\n");
        return 0;
    }
    nSize = Json::Array::size(pJsonDataItem);
    if (nSize <= 0)
    {
        printf("解析[数组大小异常]\n");
        return 0;
    }
    for (int i = 0; i < nSize; i++)
    {
        /* 获取数组的节点 */
        pItemObject = Json::Array::get(pJsonDataItem, i);
        if (NULL == pItemObject)
        {
            printf("获取数组节点失败\n");
            continue;
        }

        
        std::string strLabel = pItemObject->valuestring;
        printf("label [%s]\n", strLabel.c_str());
    }
   
    return 0;
}