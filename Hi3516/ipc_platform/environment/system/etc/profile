# /etc/profile: system-wide .profile file for the Bourne shells
#
#

set_path_before()
{
	[ -d $1 ] && PATH="$1:$PATH"
}

PATH="/usr/bin:/usr/sbin:/bin:/sbin"
set_path_before /usr/local/sbin
set_path_before /usr/local/bin

export PATH
export LD_LIBRARY_PATH

# ANSI COLORS
CRE="
[K"
NORMAL="[0;39m"
RED="[1;31m"
GREEN="[1;32m"
YELLOW="[1;33m"
BLUE="[1;34m"
MAGENTA="[1;35m"
CYAN="[1;36m"
WHITE="[1;37m"

umask 027

# 减小线程栈空间为 2MB：默认 8MB 时多线程进程虚拟栈预留过大
ulimit -s 2048

echo "${GREEN}Welcome to Linux.${NORMAL}"
#!bin/sh
export LD_LIBRARY_PATH=/lib
# 设置环境变量
export LD_LIBRARY_PATH=$LD_LIBRARY_PATH:/opt/cam/lib

# 设置系统时区
if [ -f /opt/cam/shell/set_timezone.sh ]; then
    . /opt/cam/shell/set_timezone.sh
fi
